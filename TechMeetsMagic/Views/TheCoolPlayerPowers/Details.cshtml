@model TechMeetsMagic.Models.PlayerSkills.SkillDetailsViewModel

<h1> @Html.DisplayFor(model => model.SkillName) </h1>

<div>
    <h4>Hello there, come and meet my frind: </h4>
    <hr />
    <dl class="row">
        <div class="form-group row">
            <label asp-for="ID" class="col-sm-2 col-form-label"></label>
            @Html.DisplayFor(model => model.ID)
        </div>
        <div id="imagediv">
            @foreach (var image in Model.Images)
            {
                <partial name="_Images" model="image"></partial>
            }
        </div>
        <div class="form-group row">
            <label asp-for="SkillName" class="col-sm-2 col-form-label"></label>
            @Html.DisplayFor(model => model.SkillName)
        </div>
        <div class="form-group row">
            <label asp-for="SkillDescription" class="col-sm-2 col-form-label"></label>
            @Html.DisplayFor(model => model.SkillDescription)
        </div>
        <div class="form-group row">
            <label asp-for="SkillActiveType" class="col-sm-2 col-form-label"></label>
            @Html.DisplayFor(model => model.SkillActiveType)
        </div>
        <div class="form-group row">
            <label asp-for="SkillType" class="col-sm-2 col-form-label"></label>
            @Html.DisplayFor(model => model.SkillType)
        </div>
        <div class="form-group row">
            <label asp-for="SkillTreeCategory" class="col-sm-2 col-form-label"></label>
            @Html.DisplayFor(model => model.SkillTreeCategory)
        </div>
        <div class="form-group row">
            <label asp-for="HealthAmountGainedFromHealingSkill" class="col-sm-2 col-form-label"></label>
            @Html.DisplayFor(model => model.HealthAmountGainedFromHealingSkill)
        </div>
        <div class="form-group row">
            <label asp-for="SkillDamage" class="col-sm-2 col-form-label"></label>
            @Html.DisplayFor(model => model.SkillDamage)
        </div>
        <div class="form-group row">
            <label asp-for="SkillmaxRange" class="col-sm-2 col-form-label"></label>
            @Html.DisplayFor(model => model.SkillmaxRange)
        </div>
        <div class="form-group row">
            <label asp-for="SkillRangeStart" class="col-sm-2 col-form-label"></label>
            @Html.DisplayFor(model => model.SkillRangeStart)
        </div>
        <div class="form-group row">
            <label asp-for="SkillActivationRangeStart" class="col-sm-2 col-form-label"></label>
            @Html.DisplayFor(model => model.SkillActivationRangeStart)
        </div>
        <div class="form-group row">
            <label asp-for="SkillHitboxContactAffect" class="col-sm-2 col-form-label"></label>
            @Html.DisplayFor(model => model.SkillHitboxContactAffect)
        </div>
    </dl>

    <a asp-action="Index" asp-controller="TheCoolPlayerPowers" class="btn btn-secondary">Index</a>
</div>
