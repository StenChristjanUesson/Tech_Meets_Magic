@model IEnumerable<TechMeetsMagic.Models.PlayerSkills.SkillIndexViewModels>


    @{ int rowNumber = 1; }
        <div>
            <a asp-action="add" asp-controller="TheCoolPlayerPowers" type="submit" class="btn btn-primary">Interact</a>
            <br />
            <a asp-action="Create" asp-controller="TheCoolPlayerPowers" type="submit" class="btn btn-primary">Create NPC (Limited for now due to it being Delta version at best)</a>
        </div>
    @* User can interact with the npc's using add function, to well start an interaction. in controller, this is called "Npc Talk" *@

    <div class="a1">Skill's Name</div>
<form method="post">
        <table class="table table-hover">
            <thead>
                <tr>
                    @* Later, once images have been implementedm, add image aswell*@
                    <th scope="col">#</th>
                    <th scope="col">Name</th>
                    <th scope="col">Type</th>
                    <th scope="col">Level</th>
                    <th scope="col">Admin Actions</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var skill in Model)
            {
                @* Later, once images have been implemented, add image aswell*@
                <tr>
                    <td>@rowNumber</td>
                    <td>@skill.SkillName</td>
                    <td>@skill.SkillDescription</td>
                    <td>@skill.SkillActiveType</td>
                    <td>@skill.SkillType</td>
                    <td>@skill.SkillTreeCategory</td>
                    <td>@skill.HealthAmountGainedFromHealingSkill</td>
                    <td>@skill.SkillDamage</td>
                    <td>@skill.SkillmaxRange</td>
                    <td>@skill.SkillRangeStart</td>
                    <td>@skill.SkillActivationRangeStart</td>
                    <td>@skill.SkillHitboxContactAffect</td>
                    <td>
                        <a asp-action="details" asp-controller="TheCoolPlayerPowers" asp-route-id="@skill.ID" class="btn btn-info">SkillDetails</a>

                        <a asp-action="Update" asp-controller="TheCoolPlayerPowers" asp-route-id="@skill.ID" class="btn btn-info">SkillConfigure</a>
                    </td>
                </tr>
                rowNumber++;
            }
        </tbody>
        </table>
</form>