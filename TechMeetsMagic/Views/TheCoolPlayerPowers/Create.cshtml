@model TechMeetsMagic.Models.PlayerSkills.SkillCreateViewModels

<div>
    <form method="post" asp-action="Create" enctype="multipart/form-data">
        <input asp-for="CreatedAt" type="hidden"/>
        <input asp-for="UpdatedAt" type="hidden"/>
        <input asp-for="SkillActiveType" value="1" type="hidden" />
        <input asp-for="SkillType" value="Alive" type="hidden" />
        <input asp-for="SkillHitboxContactAffect" value="Alive" type="hidden" />
        
        <div class="form-group-row">
            <label asp-for="SkillName" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">
                <input asp-for="SkillName" class="form-control" />
            </div>
        </div>

        <div class="form-group-row">
            <label asp-for="SkillDescription" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">
                <input asp-for="SkillDescription" class="form-control" />
            </div>
        </div>

        <div class="form-group-row">
            <label asp-for="SkillTreeCategory" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">
                <input asp-for="SkillTreeCategory" class="form-control" />
            </div>
        </div>

        <div class="form-group-row">
            <label asp-for="HealthAmountGainedFromHealingSkill" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">
                <input asp-for="HealthAmountGainedFromHealingSkill" class="form-control" />
            </div>
        </div>

        <div class="form-group-row">
            <label asp-for="SkillDamage" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">
                <input asp-for="SkillDamage" class="form-control" />
            </div>
        </div>

        <div class="form-group-row">
            <label asp-for="SkillmaxRange" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">
                <input asp-for="SkillmaxRange" class="form-control" />
            </div>
        </div>

        <div class="form-group-row">
            <label asp-for="SkillRangeStart" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">
                <input asp-for="SkillRangeStart" class="form-control" />
            </div>
        </div>

        <div class="form-group-row">
            <label asp-for="SkillActivationRangeStart" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">
                <input asp-for="SkillActivationRangeStart" class="form-control" />
            </div>
        </div>

        <div class="form-group-row">
            <label asp-for="Files" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-5">
                <div class="custom-file">
                    <input class="form-control custom-file-input"
                    asp-for="Files"
                    multiple type="file"
                    />
                    <label class="custom-file-label">Choose Images from device</label>
                </div>
            </div>
        </div>
        
        <input asp-action="Create" asp-controller="TheCoolPlayerPowers" type="submit" class="btn btn-primary" value="Make Skill"></input>
        <a asp-action="index" class="btn btn-primary">Cancel</a>

    </form>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('.custom-file-input').on("change", function () {
                var fileLabel = $(this).next('.custom-file-input');
                var files = $(this)[0].files;
                if (files.length > 1) {
                    files.html(files.length + ' files selected');
                }
                else if (files.length == 1) {
                    files.html(files[0].name);
                }
            });
        });
    </script>
}