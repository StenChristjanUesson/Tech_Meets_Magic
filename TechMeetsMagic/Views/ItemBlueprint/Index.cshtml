@model IEnumerable<TechMeetsMagic.Models.ItemBlueprints.BlueprintIndexViewModel>


    @{ int rowNumber = 1; }
        <div>
            <a asp-action="add" asp-controller="ItemBlueprint" type="submit" class="btn btn-primary">Interact</a>
            <br />
            <a asp-action="Create" asp-controller="ItemBlueprint" type="submit" class="btn btn-primary">Create Blueprint (Limited for now due to it being Delta version at best)</a>
        </div>
    @* User can interact with the Blueprints's using add function, to well start an interaction. in controller, this is called "Blueprint Interaction" *@

    <div class="a1">Blueprint's Name</div>
<form method="post">
        <table class="table table-hover">
            <thead>
                <tr>
                    @* Later, once images have been implementedm, add image aswell*@
                    <th scope="col">#</th>
                    <th scope="col">Name</th>
                    <th scope="col">Type</th>
                    <th scope="col">Level</th>
                    <th scope="col">Admin Actions</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var blueprint in Model)
            {
                @* Later, once images have been implemented, add image aswell*@
                <tr>
                    <td>@rowNumber</td>
                    <td>@blueprint.BlueprintName</td>
                    <td>@blueprint.Resources_Needed</td>
                    <td>@blueprint.BlueprintItemType</td>
                    <td>
                        <a asp-action="details" asp-controller="ItemBlueprint" asp-route-id="@blueprint.ID" class="btn btn-info">BlueprintDetails</a>

                        <a asp-action="Update" asp-controller="ItemBlueprint" asp-route-id="@blueprint.ID" class="btn btn-info">BlueprintConfigure</a>
                    </td>
                </tr>
                rowNumber++;
            }
        </tbody>
        </table>
</form>