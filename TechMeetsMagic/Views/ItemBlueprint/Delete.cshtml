@model TechMeetsMagic.Models.ItemBlueprints.BlueprintDeleteViewModel

<h1> @Html.DisplayFor(model => model.BlueprintName) </h1>

<div>
    <h4>Hello there, come and meet my frind: </h4>
    <hr />
    <dl class="row">
        <div class="form-group row">
            <label asp-for="ID" class="col-sm-2 col-form-label"></label>
            @Html.DisplayFor(model => model.ID)
        </div>
        <div id="imagediv">
            @foreach (var image in Model.Images)
            {
                <partial name="_Images" model="image"></partial>
            }
        </div>
        <div class="form-group row">
            <label asp-for="BlueprintName" class="col-sm-2 col-form-label"></label>
            @Html.DisplayFor(model => model.BlueprintName)
        </div>
        <div class="form-group row">
            <label asp-for="Resources_Needed" class="col-sm-2 col-form-label"></label>
            @Html.DisplayFor(model => model.Resources_Needed)
        </div>
        <div class="form-group row">
            <label asp-for="BlueprintItemType" class="col-sm-2 col-form-label"></label>
            @Html.DisplayFor(model => model.BlueprintItemType)
        </div>

    </dl>
    <form asp-action="DeleteConfirmation">
        <input type="hidden" asp-for="ID" />
        <input type="submit"value="Delete" class="btn btn-danger" />
        <a asp-action="Index" asp-controller="NPCs" class="btn btn-secondary">Index</a>
    </form>

    
</div>
