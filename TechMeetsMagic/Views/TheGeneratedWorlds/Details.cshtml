@model TechMeetsMagic.Models.TheGeneratedUserMadeOpenWorld.TheUserMadeOpenWorldDetailsViewModel

<h1> @Html.DisplayFor(model => model.WorldName) </h1>

<div>
    <h4>Hello there, come and meet my frind: </h4>
    <hr />
    <dl class="row">
        <div class="form-group row">
            <label asp-for="ID" class="col-sm-2 col-form-label"></label>
            @Html.DisplayFor(model => model.ID)
        </div>
        <div id="imagediv">
            @foreach (var image in Model.Images)
            {
                <partial name="_Images" model="image"></partial>
            }
        </div>
        <div class="form-group row">
            <label asp-for="WorldName" class="col-sm-2 col-form-label"></label>
            @Html.DisplayFor(model => model.WorldName)
        </div>
        <div class="form-group row">
            <label asp-for="WorldDescription" class="col-sm-2 col-form-label"></label>
            @Html.DisplayFor(model => model.WorldDescription)
        </div>
        <div class="form-group row">
            <label asp-for="WorldImageUrl" class="col-sm-2 col-form-label"></label>
            @Html.DisplayFor(model => model.WorldImageUrl)
        </div>
        <div class="form-group row">
            <label asp-for="WorldMapUrl" class="col-sm-2 col-form-label"></label>
            @Html.DisplayFor(model => model.WorldMapUrl)
        </div>
    </dl>

    <a asp-action="Index" asp-controller="TheGeneratedWorlds" class="btn btn-secondary">Index</a>
</div>
