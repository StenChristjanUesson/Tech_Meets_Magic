@model IEnumerable<TechMeetsMagic.Models.AvatarAppearence.AvatarIndexViewModel>


    @{ int rowNumber = 1; }
        <div>
            <a asp-action="add" asp-controller="Avatar_Appearences" type="submit" class="btn btn-primary">Interact</a>
            <br />
            <a asp-action="Create" asp-controller="Avatar_Appearences" type="submit" class="btn btn-primary">Create Avatar (Limited for now due to it being Delta version at best)</a>
        </div>
    @* User can interact with the npc's using add function, to well start an interaction. in controller, this is called "Npc Talk" *@

    <div class="a1">Avatars Name</div>
    <form method="post">
        <table class="table table-hover">
            <thead>
                <tr>
                    @* Later, once images have been implementedm, add image aswell*@
                    <th scope="col">#</th>
                    <th scope="col">Name</th>
                    <th scope="col">Type</th>
                    <th scope="col">Level</th>
                    <th scope="col">Admin Actions</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var avatar in Model)
            {
                @* Later, once images have been implemented, add image aswell*@
                <tr>
                    <td>@rowNumber</td>
                    <td>@avatar.AvatarGender</td>
                    <td>@avatar.AvatarEyeColor</td>
                    <td>@avatar.AvatarHairColor</td>
                    <td>@avatar.AvatarHairLenght</td>
                    <td>@avatar.AvatarSkinColor</td>
                    <td>
                        <a asp-action="details" asp-controller="Avatar_Appearences" asp-route-id="@avatar.ID" class="btn btn-info">AvatarDetails</a>

                        <a asp-action="Update" asp-controller="Avatar_Appearences" asp-route-id="@avatar.ID" class="btn btn-info">AvatarConfigure</a>
                    </td>
                </tr>
                rowNumber++;
            }
        </tbody>
        </table>
</form>