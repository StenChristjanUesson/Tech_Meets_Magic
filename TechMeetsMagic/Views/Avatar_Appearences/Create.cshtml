@model TechMeetsMagic.Models.AvatarAppearence.AvatarCreateViewModels

<div>
    <form method="post" asp-action="Create" enctype="multipart/form-data">
        <input asp-for="CreatedAt" type="hidden"/>
        <input asp-for="UpdatedAt" type="hidden"/>
        
        <div class="form-group-row">
            <label asp-for="AvatarGender" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">
                <input asp-for="AvatarGender" class="form-control" />
            </div>
        </div>

        <div class="form-group-row">
            <label asp-for="AvatarSkinColor" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">
                <input asp-for="AvatarSkinColor" class="form-control" />
            </div>
        </div>

        <div class="form-group-row">
            <label asp-for="AvatarHairColor" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">
                <input asp-for="AvatarHairColor" class="form-control" />
            </div>
        </div>

        <div class="form-group-row">
            <label asp-for="AvatarHairLenght" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">
                <input asp-for="AvatarHairLenght" class="form-control" />
            </div>
        </div>

        <div class="form-group-row">
            <label asp-for="AvatarEyeColor" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-10">
                <input asp-for="AvatarEyeColor" class="form-control" />
            </div>
        </div>

        <div class="form-group-row">
            <label asp-for="Files" class="col-sm-2 col-form-label"></label>
            <div class="col-sm-5">
                <div class="custom-file">
                    <input class="form-control custom-file-input"
                    asp-for="Files"
                    multiple type="file"
                    />
                    <label class="custom-file-label">Choose Images from device</label>
                </div>
            </div>
        </div>
        
        <input asp-action="Create" asp-controller="Avatar_Appearences" type="submit" class="btn btn-primary" value="Make Avatar"></input>
        <a asp-action="index" class="btn btn-primary">Cancel</a>
    </form>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('.custom-file-input').on("change", function () {
                var fileLabel = $(this).next('.custom-file-input');
                var files = $(this)[0].files;
                if (files.length > 1) {
                    files.html(files.length + ' files selected');
                }
                else if (files.length == 1) {
                    files.html(files[0].name);
                }
            });
        });
    </script>
}